# ORCA Marine Intelligence & Fishing Advisory Platform
# Environment Configuration Template

APP_NAME=ORCA Marine Intelligence API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Optional Frontend CORS Origin
# FRONTEND_ORIGIN=http://127.0.0.1:5173

# Fisheries & Satellite Data Ingestion Configuration
# Upstream INCOIS Potential Fishing Zone (PFZ) API (requires institutional access)
INCOIS_PFZ_URL=
INCOIS_API_KEY=

# Copernicus Marine Service (CMEMS) Credentials (optional)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NOAA CoastWatch ERDDAP Client Configuration
ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
# Modes: live_with_fallback | fixture_only | live_only
ERDDAP_MODE=live_with_fallback

# Fisheries Snapshot Storage & Ingestion Worker
FISHERIES_CACHE_DIR=data/fisheries_cache
FISHERIES_INGESTION_ENABLED=true
FISHERIES_INGESTION_INTERVAL_SECONDS=3600