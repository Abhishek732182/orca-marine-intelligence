        },
        "url": {
          "raw": "{{baseUrl}}/api/agents/route/analyze",
          "host": ["{{baseUrl}}"],
          "path": ["api", "agents", "route", "analyze"]
        },
        "description": "Route Agent calculates Great-Circle distance, legs, bearings, and transit times."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Preserves distinction between geodesic distance and navigable channel', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.agent).to.eql('Route Agent');",
              "    pm.expect(jsonData.status).to.eql('success');",
              "    pm.expect(jsonData.observations.total_distance_nm).to.be.above(0);",
              "    pm.expect(jsonData.observations.is_verified_navigable_route).to.eql(false);",
              "    pm.expect(jsonData.analysis.navigation_type).to.eql('geodesic_straight_line');",
              "    pm.expect(jsonData.analysis).to.have.property('navigable_route_disclaimer');",
              "    pm.expect(jsonData.warnings.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
