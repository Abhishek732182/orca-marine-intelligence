    {
      "name": "2a. Ocean Agent - Valid 24h Wave Forecast",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 15.0,\n  \"longitude\": 72.0,\n  \"location_name\": \"Offshore Goa\",\n  \"forecast_time_window_hours\": 24\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/agents/ocean/analyze",
          "host": ["{{baseUrl}}"],
          "path": ["api", "agents", "ocean", "analyze"]
        },
        "description": "Ocean Agent returns wave height metrics and WMO Code Table 3700 sea-state classification."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Correct Ocean Agent schema & sea-state classification', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.agent).to.eql('Ocean Agent');",
              "    pm.expect(jsonData.status).to.eql('success');",
              "    pm.expect(jsonData.observations.min_wave_height_m).to.not.be.null;",
              "    pm.expect(jsonData.observations.max_wave_height_m).to.not.be.null;",
              "    pm.expect(jsonData.observations.avg_wave_height_m).to.not.be.null;",
              "    pm.expect(jsonData.analysis.sea_state_code).to.not.be.null;",
              "    pm.expect(jsonData.analysis.rule_standard).to.include('WMO Code Table 3700');",
              "    // Verify no false timestamp warnings on forecast data",
              "    var joinedWarnings = (jsonData.warnings || []).join(' ');",
              "    pm.expect(joinedWarnings).to.not.include('observation_after_retrieval');",
              "    pm.expect(joinedWarnings).to.not.include('observation_time_in_future');",
              "});"
            ]
          }
        }
      ]
    },
