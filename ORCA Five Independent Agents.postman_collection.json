      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Service status is ok', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "    pm.expect(jsonData.service).to.eql('orca-api');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1a. Weather Agent - Valid Offshore Coordinates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 15.0,\n  \"longitude\": 72.0,\n  \"location_name\": \"Offshore Goa\",\n  \"forecast_days\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/agents/weather/analyze",
          "host": ["{{baseUrl}}"],
          "path": ["api", "agents", "weather", "analyze"]
        },
        "description": "Weather Agent retrieves current and forecast weather conditions for coordinates."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Correct Weather Agent identifier & schema', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.agent).to.eql('Weather Agent');",
              "    pm.expect(['success', 'insufficient_evidence', 'error']).to.include(jsonData.status);",
              "    pm.expect(jsonData).to.have.property('data_source');",
              "    pm.expect(jsonData).to.have.property('observations');",
              "    pm.expect(jsonData).to.have.property('analysis');",
              "    pm.expect(jsonData).to.have.property('warnings');",
              "    pm.expect(jsonData).to.have.property('generated_at');",
              "    if (jsonData.status === 'success') {",
              "        pm.expect(jsonData.observations).to.have.property('temperature_c');",
              "        pm.expect(jsonData.observations).to.have.property('wind_speed_knots');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Weather Agent - Geocoding by Location Name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
